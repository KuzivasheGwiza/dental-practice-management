# Only used by the optional docker-compose SQL Server setup.
# Use your own strong local secret and never commit a real production password.
MSSQL_SA_PASSWORD=

# ASP.NET PayFast settings (examples only; set real values in your host/secret store)
# PayFast__Enabled=true
# PayFast__Sandbox=false
# PayFast__MerchantId=YOUR_MERCHANT_ID
# PayFast__MerchantKey=YOUR_MERCHANT_KEY
# PayFast__Passphrase=YOUR_PASSPHRASE
# PayFast__FrontendBaseUrl=https://your-practice-domain.example
# PayFast__PublicApiBaseUrl=https://api.your-practice-domain.example
# PayFast__PaymentWindowMinutes=15
# PayFast__RequireIpValidation=true
